{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vigil",
  "version": "0.1.0",
  "identifier": "dev.vigil.taskmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cargo build -p vigil-service --bins --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vigil",
        "width": 1240,
        "height": 800,
        "minWidth": 860,
        "minHeight": 540,
        "center": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "visible": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://vigil.localhost vigil:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Vigil contributors",
    "copyright": "© 2026 Vigil contributors",
    "homepage": "https://github.com/Ray-lea/Vigil",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "taskmgr-hooks.nsh"
      }
    }
  }
}
